{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "port": __PORT__,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "__UUID__" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            { "certificateFile": "__TLS_CERT__", "keyFile": "__TLS_KEY__" }
          ]
        },
        "wsSettings": { "path": "__WS_PATH__" }
      }
    }
  ],
  "outbounds": [{ "protocol": "freedom", "tag": "direct" }]
}
